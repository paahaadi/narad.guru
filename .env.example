# ============================================================================
# NARAD V2 — Environment Configuration
# ============================================================================
# Copy this file to .env and fill in your actual keys.
# NEVER commit the .env file to version control.
# ============================================================================


# ── Core Infrastructure ─────────────────────────────────────────────────────

# PostgreSQL 16 (TimescaleDB + PostGIS + pgvector + pg_trgm)
DATABASE_URL=postgresql://narad_user:CHANGE_ME@localhost:5432/narad_v2
DATABASE_POOL_SIZE=20

# Redis 7 (projections, semantic cache, WS presence, rate-limiting)
REDIS_URL=redis://localhost:6379/0
REDIS_CACHE_DB=1
REDIS_WS_DB=2

# S3-Compatible Object Storage (sovereign-hosted)
S3_ENDPOINT=https://s3.your-sovereign-region.example.com
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_BUCKET_DOCUMENTS=narad-documents
S3_BUCKET_EVIDENCE=narad-evidence
S3_BUCKET_TILES=narad-tiles
S3_BUCKET_DARK_ARCHIVE=narad-dark-archive


# ── Auth & Security ─────────────────────────────────────────────────────────

# JWT (RS256)
JWT_PRIVATE_KEY_PATH=./keys/jwt_private.pem
JWT_PUBLIC_KEY_PATH=./keys/jwt_public.pem
JWT_ISSUER=narad.guru
JWT_ACCESS_TOKEN_EXPIRY=15m
JWT_REFRESH_TOKEN_EXPIRY=7d


# ── AI / LLM Providers ─────────────────────────────────────────────────────

# Primary LLM (story capsule, briefing draft, claim extraction, LexPulse RAG)
# Options: gemini | openai | ollama
LLM_PROVIDER=gemini

# Google Gemini API
GEMINI_API_KEY=
GEMINI_MODEL_MID=gemini-2.5-flash
GEMINI_MODEL_LARGE=gemini-2.5-pro

# OpenAI (fallback)
OPENAI_API_KEY=
OPENAI_MODEL_MID=gpt-4o-mini
OPENAI_MODEL_LARGE=gpt-4o

# Self-hosted Ollama (sovereign fallback)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1:70b

# Embedding Model
EMBEDDING_PROVIDER=gemini
EMBEDDING_MODEL=text-embedding-004
EMBEDDING_DIMENSIONS=768


# ── Tier 1 Data Sources (Official / Government) ────────────────────────────

# Press Information Bureau (PIB) — RSS feed, no key required
PIB_RSS_URL=https://pib.gov.in/RssMain.aspx?ModId=6&Lang=1&Regid=3

# eGazette of India — public access
EGAZETTE_BASE_URL=https://egazette.gov.in
EGAZETTE_API_KEY=

# Securities and Exchange Board of India (SEBI)
SEBI_BASE_URL=https://www.sebi.gov.in
SEBI_API_KEY=

# Ministry of Corporate Affairs — MCA21 Portal (CorpWatch entity data)
MCA21_BASE_URL=https://www.mca.gov.in
MCA21_API_KEY=
MCA21_USERNAME=
MCA21_PASSWORD=

# Parliament of India — Lok Sabha / Rajya Sabha (LexPulse corpus)
PARLIAMENT_LS_URL=https://loksabha.nic.in
PARLIAMENT_RS_URL=https://rajyasabha.nic.in
PARLIAMENT_API_KEY=

# Reserve Bank of India
RBI_BASE_URL=https://rbi.org.in
RBI_API_KEY=

# Digital Public Infrastructure (DPI) / India Stack
DPI_API_KEY=
DPI_ENDPOINT=


# ── Tier 2 Data Sources (Structured / Semi-Structured) ─────────────────────

# ACLED — Armed Conflict Location & Event Data (OAuth 2.0)
# Token obtained via POST to ACLED_OAUTH_URL with email+password
# Access token valid 24h; refresh token valid 14 days
ACLED_EMAIL=
ACLED_PASSWORD=
ACLED_OAUTH_URL=https://acleddata.com/oauth/token
ACLED_CLIENT_ID=acled
ACLED_BASE_URL=https://acleddata.com/api/acled/read

# NASA FIRMS — Fire Information for Resource Management System
NASA_FIRMS_MAP_KEY=
NASA_FIRMS_BASE_URL=https://firms.modaps.eosdis.nasa.gov/api

# OpenSky Network — ADS-B aircraft tracking (free tier)
OPENSKY_USERNAME=
OPENSKY_PASSWORD=
OPENSKY_BASE_URL=https://opensky-network.org/api

# GDELT Project — Global media monitoring
GDELT_BASE_URL=https://api.gdeltproject.org/api/v2
# GDELT is public, no key required

# Indian Meteorological Department (IMD) — weather layer
IMD_API_KEY=
IMD_BASE_URL=https://mausam.imd.gov.in

# National Disaster Management Authority (NDMA)
NDMA_API_KEY=
NDMA_BASE_URL=https://ndma.gov.in

# BSE / NSE Market Data
BSE_API_KEY=
NSE_API_KEY=


# ── Tier 3 Data Sources (Unstructured / Social / OSINT) ─────────────────────
# NOTE: Tier 3 sources require governance_approved = TRUE before ingest.

# Twitter / X API (OSINT monitoring)
TWITTER_API_KEY=
TWITTER_API_SECRET=
TWITTER_BEARER_TOKEN=

# Reddit API (community intelligence signals)
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USER_AGENT=narad-v2/1.0

# Telegram Bot API (channel monitoring)
TELEGRAM_BOT_TOKEN=
TELEGRAM_MONITORED_CHANNELS=

# YouTube Data API (press conference monitoring)
YOUTUBE_API_KEY=

# Google Custom Search (web crawl fallback)
GOOGLE_SEARCH_API_KEY=
GOOGLE_SEARCH_CX=

# News API (aggregated news fallback)
NEWSAPI_KEY=


# ── Language & Translation ──────────────────────────────────────────────────

# Bhashini API — multilingual Indian language translation
BHASHINI_API_KEY=
BHASHINI_USER_ID=
BHASHINI_PIPELINE_ID=
BHASHINI_BASE_URL=https://dhruva-api.bhashini.gov.in


# ── Geospatial Services ────────────────────────────────────────────────────

# PMTiles — self-hosted, no API key needed
PMTILES_BASE_PATH=./data/tiles

# Terrain DEM (3D map, enabled at zoom >= 8)
TERRAIN_DEM_URL=https://your-sovereign-dem-tiles.example.com/{z}/{x}/{y}.png

# Survey of India / Bhuvan (optional sovereign base map)
BHUVAN_API_KEY=
BHUVAN_BASE_URL=https://bhuvan.nrsc.gov.in

# ISRO Bhuvan WMS (satellite imagery layer)
BHUVAN_WMS_URL=https://bhuvan-vec1.nrsc.gov.in/bhuvan/wms


# ── Monitoring & Observability ──────────────────────────────────────────────

# Application telemetry
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
OTEL_SERVICE_NAME=narad-v2

# Error tracking (optional)
SENTRY_DSN=


# ── Application Settings ───────────────────────────────────────────────────

NODE_ENV=development
PORT=3000
WS_PORT=3001
LOG_LEVEL=info

# Ingest worker settings
INGEST_POLL_INTERVAL_MS=60000
EMBED_BATCH_SIZE=50
EMBED_BATCH_WINDOW_MS=30000

# Semantic cache TTL (LexPulse RAG)
RAG_CACHE_TTL_SECONDS=14400
RAG_SIMILARITY_THRESHOLD=0.92

# Feed projection batch interval
FEED_PROJECTION_BATCH_MS=500

# WebSocket latency ping interval
WS_PING_INTERVAL_MS=5000
